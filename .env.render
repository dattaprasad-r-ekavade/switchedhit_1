# Render.com Environment Variables

Copy these to your Render.com dashboard under "Environment Variables"

## Required Variables

APP_NAME=SwitchedHit
APP_ENV=production
APP_KEY=base64:AyfjTJwooZUO9s4GN7B0aK4GqK6DGuK3lVwO9IPKsDs=
APP_DEBUG=false
APP_URL=https://switchedhit.onrender.com
ASSET_URL=https://switchedhit.onrender.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/var/data/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

## Optional: Mail Configuration

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

## Notes:
# 1. Replace APP_KEY with your actual key (run: php artisan key:generate --show)
# 2. Update APP_URL after first deployment with your actual Render URL
# 3. Make sure to create a persistent disk mounted at /var/data
# 4. Set APP_DEBUG=false for production security
